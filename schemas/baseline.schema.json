{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "baseline",
  "type": "object",
  "required": [
    "character_id",
    "baseline_version",
    "status",
    "features",
    "variants",
    "invalidates"
  ],
  "properties": {
    "character_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseline_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "discovery",
        "draft",
        "frozen",
        "superseded"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "feature_id",
          "domain",
          "value",
          "status",
          "classification",
          "evidence",
          "acceptance",
          "criticality"
        ],
        "properties": {
          "feature_id": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "value": {},
          "status": {
            "enum": [
              "decided",
              "proposed",
              "unknown",
              "not_applicable"
            ]
          },
          "classification": {
            "enum": [
              "invariant",
              "variant",
              "flexible"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "string"
          },
          "criticality": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          }
        }
      }
    },
    "variants": {
      "type": "array"
    },
    "invalidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
